# =============================================================================
# ClubHub Frontend Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# --- Supabase (required) ---
# Get these from: Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- AI Assistant (optional) ---
# The AI currently uses a built-in keyword ranker by default.
# To enable a real LLM, set the provider and API key in the database
# via the Supabase Dashboard (SQL Editor), then deploy the edge function.
#
# Supported providers: groq (free), gemini (free), openai (paid)
# After configuring, run:
#   supabase functions deploy ai-chat
#
# For Groq (RECOMMENDED — free tier):
#   1. Get API key: https://console.groq.com/keys
#   2. Set in Supabase Dashboard > Settings > Edge Functions > Secrets:
#      GROQ_API_KEY=your_groq_api_key
#   3. Run SQL in Supabase Dashboard > SQL Editor:
#      UPDATE ai_config SET value='groq' WHERE key='provider';
#      UPDATE ai_config SET value='llama-3.3-70b-versatile' WHERE key='model';
#      UPDATE ai_config SET value='your_groq_api_key' WHERE key='api_key';
#
# For Gemini (free tier):
#   1. Get API key: https://aistudio.google.com/apikey
#   2. Set in Supabase Dashboard > Settings > Edge Functions > Secrets:
#      GEMINI_API_KEY=your_gemini_api_key
#   3. Run SQL:
#      UPDATE ai_config SET value='gemini' WHERE key='provider';
#      UPDATE ai_config SET value='gemini-1.5-flash' WHERE key='model';
#      UPDATE ai_config SET value='your_gemini_api_key' WHERE key='api_key';
#
# For OpenAI (paid):
#   1. Get API key: https://platform.openai.com/api-keys
#   2. Set in Supabase Dashboard > Settings > Edge Functions > Secrets:
#      OPENAI_API_KEY=your_openai_api_key
#   3. Run SQL:
#      UPDATE ai_config SET value='openai' WHERE key='provider';
#      UPDATE ai_config SET value='gpt-4o-mini' WHERE key='model';
#      UPDATE ai_config SET value='your_openai_api_key' WHERE key='api_key';
#
# To DISABLE LLM and use keyword ranker only:
#   UPDATE ai_config SET value='keyword' WHERE key='provider';
